{
  "name": "tmatrix-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Outbound-only Codex App Server daemon for API-backed ticket queues",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "sh scripts/stage-engine.sh",
    "check": "npm run typecheck && npm test && npm run test:worktrees",
    "check:config": "tsx src/index.ts --check-config",
    "dev": "tsx watch src/index.ts",
    "start": "node staging/engine/dist/index.js",
    "start:once": "node staging/engine/dist/index.js --once",
    "test": "vitest run",
    "test:worktrees": "python3 -m unittest discover -s test -p '*_test.py'",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openai/codex": "0.158.0",
    "@openai/codex-sdk": "0.158.0",
    "pino": "9.14.0",
    "pino-pretty": "11.3.0",
    "rotating-file-stream": "3.2.9",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "20.19.24",
    "@types/ws": "8.18.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "license": "MIT"
}
